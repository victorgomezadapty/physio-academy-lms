# Physio Academy LMS — environment variables
# Copy this file to .env.local and fill in your own Supabase project values.

# Supabase project URL and anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key — server-side only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
